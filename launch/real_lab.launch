<launch>
    <arg name="visualize" default="false" />
    <arg name="data" default="false" />
    <arg name="robot_name" default="hound_vio" />
    <arg name="policy" default="drift" />

    <!-- UNCOMMENT IF USING MOCAP -->
    <!-- for elevation launch the object publisher to keep track of object poses -->
    <!-- <group if="$(eval arg('policy') == 'elevation')">
        <include file="$(find mushr_mocap)/launch/object_publisher.launch">
            <arg name="asset_name" value="$(arg robot_name)" />
        </include>
        <node pkg="real_lab" type="heightmap_publisher.py" name="heightmap" output="screen"/>
    </group> -->
    <!-- otherwise just pulish car odom -->
    <!-- <group unless="$(eval arg('policy') == 'elevation')">
        <include file="$(find mushr_mocap)/launch/car_odom_publisher.launch">
            <arg name="asset_name" value="$(arg robot_name)" />
        </include>
    </group> -->

    <!-- launching vio if the robot is hound_vio, otherwise launch depth camera-->
    <group if="$(eval arg('robot_name') == 'hound_vio')">
        <include file="$(find realsense2_camera)/launch/rs_t265.launch"/>
        <node pkg="real_lab" type="odom_publisher.py" name="odometry_processor" output="screen"/>
        <node pkg="timed_roslaunch" type="timed_roslaunch.sh" args="10 hound_core apm.launch" name="apm_timed" output="screen" launch-prefix="nice -n -1"/>
    </group>
    <group unless="$(eval arg('robot_name') == 'hound_vio')">
        <node pkg="timed_roslaunch" type="timed_roslaunch.sh" args="5 hound_core realsense_d455_HOUND.launch" name="camera_timed" output="screen"/>
        <node pkg="timed_roslaunch" type="timed_roslaunch.sh" args="10 hound_core apm.launch fcu_url:=/dev/ttyACM1:921600" name="apm_timed" 
                output="screen" launch-prefix="nice -n -1"/>
    </group>

    <!-- launching the base hound system -->
    <node pkg="hound_core" type="HAL_9000.py" name="HAL" output="screen"/>    
    <node pkg="timed_roslaunch" type="timed_roslaunch.sh" args="50 hound_core vesc_driver_node.launch" name="vesc_timed" output="screen"/>

    <!-- <node pkg="timed_roslaunch" type="timed_roslaunch.sh" args="30 hound_core X4.launch" name="lidar_timed" output="screen"/> -->

    <!-- uncomment the following two lines to use visual odometry (make sure to set EK3_SRC2_VELXY and EK3_SRC2_VELZ to 6 in ardupilot params) -->
<!--     <node pkg="timed_roslaunch" type="timed_roslaunch.sh" args="90 hound_core HOUND_vis_odom.launch" name="vis_odom" output="log"/>
    <node pkg="hound_core" type="viso_to_mavros.py" name="viso_odom" output="log"/> -->
    <!-- <node pkg="hound_core" type="vesc_to_odom.py" name="wheel_odom" output="log"/> -->

    <arg name="low_level_Config" default="$(find hound_core)/config/low_level_Config_real.yaml" />
    <rosparam file="$(arg low_level_Config)" command="load" />
    
    <node pkg="hound_core" type="hound_ll_control" name="low_level_controller" launch-prefix="nice -n -1"/>

    <node pkg="hound_core" type="osm_router.py" name="router" output="screen"/>

    <!-- <node pkg="timed_roslaunch" type="timed_roslaunch.sh" args="15 elevation_mapping_cupy elevation_mapping_cupy_no_vis.launch" name="elevation_mapping" output="log"/>
    <include file="$(find ntrip_ros)/launch/ntripclient.launch"/>  -->

    <node pkg="real_lab" type="rl_hl_control.py" name="high_level_controller" output="screen">
        <param name="policy" value="$(arg policy)" />
        <param name="data_collection" value="$(arg data)" />
    </node>
   
    <!-- <node pkg="hound_core" type="hound_hl_control.py" name="high_level_controller" output="screen"/> -->
    <group if ="$(arg data)">
        <node pkg="real_lab" type="data_collector.py" name="data_collector" output="screen"/>
    </group>

    <!-- Group of nodes launched only if visualize is true -->
    <group if="$(arg visualize)">
        <!-- <node pkg="hound_core" type="state_spliter.py" name="state_splitter" output="screen" /> -->
        <!-- <node pkg="hound_core" type="pose_republisher.py" name="pose_republisher" output="screen" /> -->
        <node pkg="real_lab" type="action_republisher.py" name="action_republisher" output="screen" />
    </group>
</launch>
